# --- Chain -------------------------------------------------------------------
RPC_URL=https://rpc-test.qday.info
CHAIN_ID=44005
EXPLORER_URL=https://explorer-test.qday.info
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# Mediator identity (the *owner* address registered in MediatorRegistry; its key stays cold).
MEDIATOR_ADDRESS=0x0000000000000000000000000000000000000000
# Scoped session key: may ONLY call propose(), expires, has a proposal budget. Never the owner key.
SESSION_KEY_PRIVATE_KEY=0x...

# --- Decision engine ---------------------------------------------------------
# "claude" uses the Anthropic API; "rules" applies the escrow's pre-agreed fallback split (no LLM).
MEDIATOR_MODE=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Service -----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
EVIDENCE_DIR=../evidence-data
POLL_INTERVAL_MS=15000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Max evidence upload size in bytes (default 5 MiB).
MAX_EVIDENCE_BYTES=5242880
